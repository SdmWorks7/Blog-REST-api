<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css" />
    <title>Posts</title>
</head>
<body>
    <h1>Blog Posts</h1>
    <% for(post of posts){ %>
        <div class="post">
            <h3>@<%=post.username %></h3>
            <p> <%= post.content %></p>
            <a href="http://localhost:8080/posts/<%= post.id %>">see in detail</a><br>
            <a href="http://localhost:8080/posts/<%= post.id %>/edit">edit</a>
            <br>
            <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                <button>Delete!</button>
            </form>
        </div>
        <% } %>
        <br>
        <br>
        <a href="http://localhost:8080/posts/new">Create new Post</a>
</body>
</html>